@model List<ContractMonthlyClaimSystem.Models.Lecturer>

@{
    ViewData["Title"] = "HR - Lecturers";
}

<h2 class="mb-4"><i class="bi bi-people me-2"></i>Lecturer Management</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Email</th>
                    <th class="pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lecturer in Model)
                {
                    <tr>
                        <td class="ps-4">@lecturer.Name</td>
                        <td>@lecturer.Email</td>
                        <td class="pe-4">
                            <a asp-controller="HR" asp-action="EditLecturer" asp-route-id="@lecturer.Id" class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>