@model List<ContractMonthlyClaimSystem.Models.Claim>

@{
    ViewData["Title"] = "Pending Claims";
}

<h2 class="mb-4"><i class="bi bi-clipboard-check me-2"></i>Pending Claims for Approval</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Claim ID</th>
                    <th>Lecturer</th>
                    <th>Hours Worked</th>
                    <th>Hourly Rate</th>
                    <th>Status</th>
                    <th class="pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    bool isFlagged = claim.HoursWorked > 60 || claim.HourlyRate > 1000;
                    <tr class="@(isFlagged ? "table-warning" : "")">
                        <td class="ps-4">#@claim.Id</td>
                        <td>@claim.Lecturer.Name</td>
                        <td>@claim.HoursWorked</td>
                        <td>R@(claim.HourlyRate)</td>
                        <td>
                            <span class="badge bg-warning text-dark px-3 py-2">@claim.Status</span>
                            @if (isFlagged)
                            {
                                <br />
                                <span class="badge bg-danger mt-1"><i class="bi bi-exclamation-triangle"></i> Review Needed</span>
                            }
                        </td>
                        <td class="pe-4">
                            <form asp-controller="Approval" asp-action="Approve" asp-route-id="@claim.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-lg"></i> Approve
                                </button>
                            </form>
                            <form asp-controller="Approval" asp-action="Reject" asp-route-id="@claim.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-x-lg"></i> Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>