@model ContractMonthlyClaimSystem.Models.Claim

@{
    ViewData["Title"] = "Submit Claim";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-file-earmark-plus me-2"></i>Submit a Claim</h4>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Claim" asp-action="Submit" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="HoursWorked" class="form-label fw-semibold">Hours Worked</label>
                        <input asp-for="HoursWorked" class="form-control" placeholder="e.g. 20" />
                        <span asp-validation-for="HoursWorked" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HourlyRate" class="form-label fw-semibold">Hourly Rate (R)</label>
                        <input asp-for="HourlyRate" class="form-control" placeholder="e.g. 350" />
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold">Additional Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes about this claim"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Supporting Document</label>
                        <input type="file" name="document" class="form-control" />
                        <small class="text-muted">Accepted formats: .pdf, .docx, .xlsx</small>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-send-check me-1"></i> Submit Claim
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}