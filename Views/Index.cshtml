@model List<ContractMonthlyClaimSystem.Models.Claim>

@{
    ViewData["Title"] = "Pending Claims";
}

<h2>Pending Claims for Approval</h2>

<table class="table">
    <thead>
        <tr>
            <th>Claim ID</th>
            <th>Lecturer</th>
            <th>Hours Worked</th>
            <th>Hourly Rate</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in Model)
        {
            <tr>
                <td>@claim.Id</td>
                <td>@claim.Lecturer.Name</td>
                <td>@claim.HoursWorked</td>
                <td>R@claim.HourlyRate</td>
                <td>@claim.Status</td>
                <td>
                    <form asp-controller="Approval" asp-action="Approve" asp-route-id="@claim.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                    </form>
                    <form asp-controller="Approval" asp-action="Reject" asp-route-id="@claim.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>